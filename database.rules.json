{
  "rules": {
    "drivers": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!data.exists() || root.child('admins').child(auth.uid).val() === true || (!newData.hasChild('approved') || newData.child('approved').val() === data.child('approved').val()) && (!newData.hasChild('rating') || newData.child('rating').val() === data.child('rating').val()) && (!newData.hasChild('suspended') || newData.child('suspended').val() === data.child('suspended').val())"
      }
    },
    "driver_locations": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "driverLocations": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "trips": {
      ".read": true,
      "$tripId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['status', 'from', 'to', 'price']) && (!data.exists() || newData.child('price').val() === data.child('price').val()) && (!data.exists() || data.child('status').val() !== 'completed' || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "driver_requests": {
      ".read": true,
      "$tripId": {
        ".write": "auth != null"
      }
    },
    "customer_trips": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "customers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!data.exists() || root.child('admins').child(auth.uid).val() === true || (!newData.hasChild('role') || newData.child('role').val() === data.child('role').val())"
      }
    },
    "wallets": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "pricing": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },
    "admin_logs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "stats": {
      ".read": true,
      ".write": "auth != null"
    },
    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
