{
  "rules": {
    "drivers": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!data.exists() || root.child('admins').child(auth.uid).val() === true || (!newData.hasChild('approved') || newData.child('approved').val() === data.child('approved').val()) && (!newData.hasChild('rating') || newData.child('rating').val() === data.child('rating').val()) && (!newData.hasChild('suspended') || newData.child('suspended').val() === data.child('suspended').val())"
      }
    },
    "driver_locations": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "driverLocations": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "trips": {
      ".read": "auth != null",
      "$tripId": {
        ".write": "auth != null && (!data.exists() || data.child('customerId').val() === auth.uid || data.child('driverId').val() === auth.uid || (!data.child('driverId').exists() && newData.child('driverId').val() === auth.uid && root.child('drivers').child(auth.uid).child('approved').val() === true) || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['status', 'from', 'to', 'price']) && (!data.exists() || newData.child('price').val() === data.child('price').val()) && (!data.exists() || data.child('status').val() !== 'completed' || newData.child('status').val() === 'completed' || root.child('admins').child(auth.uid).val() === true)",
        "statusTimeline": {
          "$logId": {
            ".validate": "!data.exists() && newData.exists()"
          }
        }
      }
    },
    "driver_requests": {
      ".read": "auth != null",
      "$tripId": {
        ".write": "auth != null && (!data.exists() || data.child('customerId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true || (auth.uid === newData.child('driverId').val() && root.child('drivers').child(auth.uid).child('approved').val() === true))"
      }
    },
    "scheduled_trips": {
      ".read": "auth != null",
      "$tripId": {
        ".write": "auth != null && (!data.exists() || data.child('customerId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "customer_trips": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "customers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!data.exists() || root.child('admins').child(auth.uid).val() === true || (!newData.hasChild('role') || newData.child('role').val() === data.child('role').val())"
      }
    },
    "wallets": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "reviews": {
      ".read": true,
      "$reviewId": {
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "complaints": {
      ".read": "auth != null",
      "$complaintId": {
        ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "pricing": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },
    "admin_logs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$logId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "!data.exists() && newData.exists()"
      }
    },
    "stats": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null"
      }
    }
  }
}
